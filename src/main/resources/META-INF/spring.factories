# Spring Boot 4.2 loads EnvironmentPostProcessor from META-INF/spring.factories
# via SpringFactoriesLoader.forDefaultResourceLocation. The older
# META-INF/spring/org.springframework.boot.EnvironmentPostProcessor.imports
# file is not read. The Boot 4.2 packager keeps application META-INF entries
# at the root of the executable jar; java -jar still sees them through the
# system classloader parent of LaunchedClassLoader.
org.springframework.boot.EnvironmentPostProcessor=\
com.ozerler.marble.config.DatabaseUrlEnvironmentPostProcessor,\
com.ozerler.marble.config.SecretFileEnvironmentPostProcessor
