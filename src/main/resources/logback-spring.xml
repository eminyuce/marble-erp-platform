<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Read application name and active profiles from Spring Environment -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="marble-erp-platform"/>
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="default"/>

    <springProperty scope="context" name="asyncQueueCapacity" source="logging.async.queue-capacity"
                    defaultValue="8192"/>
    <springProperty scope="context" name="asyncHighWaterMarkPercent" source="logging.async.high-water-mark-percent"
                    defaultValue="90"/>
    <springProperty scope="context" name="asyncOverflowPolicy" source="logging.async.overflow-policy"
                    defaultValue="DROP_LOW_PRIORITY"/>
    <springProperty scope="context" name="asyncBatchSize" source="logging.async.batch-size" defaultValue="256"/>
    <springProperty scope="context" name="asyncDrainTimeoutMillis" source="logging.async.drain-timeout-millis"
                    defaultValue="5000"/>
    <springProperty scope="context" name="asyncPollTimeoutMillis" source="logging.async.poll-timeout-millis"
                    defaultValue="100"/>
    <springProperty scope="context" name="asyncIncludeCallerData" source="logging.async.include-caller-data"
                    defaultValue="false"/>

    <!-- Structured JSON Console Appender -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Custom static fields included in every JSON log entry -->
            <customFields>{"app_name":"${appName}","environment":"${activeProfile}"}</customFields>

            <!-- Timestamp formatting (ISO-8601 UTC) -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
            <timeZone>UTC</timeZone>

            <!-- Include all MDC entries directly in root JSON object (userId, correlationId, etc.) -->
            <includeMdc>true</includeMdc>

            <!-- Logger name formatting -->
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>

            <!-- Stack trace configuration -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <shortenedClassNameLength>25</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <appender name="ASYNC" class="com.ozerler.marble.logging.AsyncLoggingAppender">
        <queueCapacity>${asyncQueueCapacity}</queueCapacity>
        <highWaterMarkPercent>${asyncHighWaterMarkPercent}</highWaterMarkPercent>
        <overflowPolicy>${asyncOverflowPolicy}</overflowPolicy>
        <batchSize>${asyncBatchSize}</batchSize>
        <drainTimeoutMillis>${asyncDrainTimeoutMillis}</drainTimeoutMillis>
        <pollTimeoutMillis>${asyncPollTimeoutMillis}</pollTimeoutMillis>
        <includeCallerData>${asyncIncludeCallerData}</includeCallerData>
        <appender-ref ref="CONSOLE_JSON"/>
    </appender>

    <!-- Application Loggers -->
    <logger name="com.ozerler.marble" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="ASYNC"/>
    </root>

</configuration>
