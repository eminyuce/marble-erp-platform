# Copy to `.env` for Docker Compose and local shells. Do not put production secrets here.

# PostgreSQL
DB_NAME=marble_erp
DB_USERNAME=marbleuser
DB_PASSWORD=marblepass
DB_PORT=5432

# Object storage (MinIO)
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=marbleminio
MINIO_ROOT_PASSWORD=marbleminio_change_me
MINIO_ACCESS_KEY=marbleminio
MINIO_SECRET_KEY=marbleminio_change_me
MINIO_BUCKET=erp-files
MINIO_REGION=us-east-1

# When Spring Boot runs inside Docker Compose, use:
# MINIO_ENDPOINT=http://minio:9000
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Optional bind mount for production MinIO data, e.g. /opt/minio/data
# MINIO_DATA_DIR=

# Legacy filesystem directories used only while migrating existing files
APP_MEDIA_DIR=media
APP_UPLOAD_DIR=media

# STORAGE_MIGRATE_ENABLED=false
# STORAGE_MIGRATE_DRY_RUN=true
