# Placeholder names only. Do not put real passwords in this file.
# Production values live in /opt/marble-erp/secrets/*.txt and are mounted at /run/secrets.

DEPLOY_DIR=/opt/marble-erp
SECRETS_DIR=/opt/marble-erp/secrets
DB_NAME=marble_erp
DB_USERNAME=marbleuser
DB_HOST=postgres
DB_PORT=5432
CORS_ALLOWED_ORIGIN=https://ozerler.naklink.com
RUSTFS_PUBLIC_ENDPOINT=https://ozerler.naklink.com
APP_TAG=latest

# TOTP 2FA key: no value here. docker-compose.prod.yml mounts
# ${SECRETS_DIR}/totp_encryption_key.txt as TOTP_ENCRYPTION_KEY_FILE=/run/secrets/totp_encryption_key.
# Create it once with scripts/setup-secrets.sh (base64 of 32 random bytes). Never regenerate it.
