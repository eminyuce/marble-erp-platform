# Copy to `.env` for Docker Compose and local shells. Do not commit `.env`.
# On the production server, change every password before the first start.

# PostgreSQL
DB_NAME=marble_erp
DB_USERNAME=marbleuser
DB_PASSWORD=marblepass
DB_PORT=5432

# Object storage (RustFS Docker)
STORAGE_TYPE=rustfs
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=marblerustfs
RUSTFS_SECRET_KEY=marblerustfs_change_me
RUSTFS_BUCKET=erp-files
RUSTFS_REGION=us-east-1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# When Spring Boot runs inside Docker Compose, use:
# RUSTFS_ENDPOINT=http://rustfs:9000
# RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000

# Existing production disks. Do not point these at empty paths.
# Postgres data already lives in the Docker volume docker_postgres_data.
POSTGRES_VOLUME_NAME=docker_postgres_data
# RustFS objects already live in this directory. It must be writable by uid 10001.
RUSTFS_DATA_DIR=/opt/rustfs/data

# Legacy filesystem directories used only while migrating existing files
APP_MEDIA_DIR=media
APP_UPLOAD_DIR=media

# STORAGE_MIGRATE_ENABLED=false
# STORAGE_MIGRATE_DRY_RUN=true

# Production image published by GitHub Actions (docker-compose.prod.yml).
# DOCKERHUB_USERNAME must match the Docker Hub account that owns the image.
DOCKERHUB_USERNAME=guvenulu
APP_TAG=latest
APP_PORT=81

# Directory on the server that holds docker-compose.prod.yml and .env.
MARBLE_HOST_STACK_DIR=/opt/marble-erp
MARBLE_HOST_LOG_DIR=/opt/marble-erp/logs
# Group id of the Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Public site origin used by the browser. On a remote server set the real URL.
# CORS_ALLOWED_ORIGIN=https://ozerler.naklink.com
