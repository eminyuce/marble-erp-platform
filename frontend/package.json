{
  "name": "marble-erp-frontend",
  "version": "1.0.0",
  "description": "Tailwind CSS 4 build pipeline for Özerler Mermer ERP",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ../src/main/resources/static/css/app.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ../src/main/resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  }
}
